# Copy to .dev.vars for local `wrangler dev` / vite preview against Worker bindings.
# Production values go in `wrangler secret put` on the bissibox-cloud Worker.
# Never commit .dev.vars.

# Required on the Worker (runtime)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BISSIBOX_SESSION_SECRET=

# Optional Worker
MAPBOX_PUBLIC_TOKEN=
